<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Berita - Koperasi Desa Merah Putih Unjur</title>

    <style>
        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            font-family: Arial, sans-serif;
            background: #f5f5f5;
            color: #222;
        }

        header {
            background: linear-gradient(135deg, #b40000, #e00000);
            color: white;
            padding: 25px 20px;
        }

        .header-inner {
            max-width: 1100px;
            margin: auto;
        }

        header h1 {
            margin: 0 0 8px;
            font-size: 28px;
        }

        header p {
            margin: 0;
            opacity: 0.95;
        }

        nav {
            background: white;
            border-bottom: 1px solid #ddd;
        }

        .nav-inner {
            max-width: 1100px;
            margin: auto;
            display: flex;
            flex-wrap: wrap;
        }

        nav a {
            color: #333;
            text-decoration: none;
            padding: 14px 16px;
            display: block;
        }

        nav a:hover {
            background: #fbeaea;
            color: #b40000;
        }

        main {
            max-width: 1100px;
            margin: 30px auto;
            padding: 0 15px;
        }

        .judul-halaman {
            margin-bottom: 20px;
        }

        .judul-halaman h2 {
            margin: 0 0 5px;
            color: #b40000;
        }

        .judul-halaman p {
            color: #666;
            margin: 0;
        }

        .berita-list {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
            gap: 20px;
        }

        .berita-card {
            background: white;
            border-radius: 12px;
            overflow: hidden;
            box-shadow: 0 3px 12px rgba(0,0,0,0.08);
        }

        .berita-gambar {
            width: 100%;
            height: 190px;
            object-fit: cover;
            background: #eee;
        }

        .berita-tanpa-gambar {
            height: 120px;
            background: linear-gradient(135deg, #b40000, #e00000);
        }

        .berita-content {
            padding: 18px;
        }

        .berita-content h3 {
            margin: 0 0 8px;
            font-size: 20px;
            color: #222;
        }

        .tanggal {
            font-size: 13px;
            color: #888;
            margin-bottom: 12px;
        }

        .isi {
            line-height: 1.6;
            color: #555;
            white-space: pre-line;
        }

        .kosong,
        .error {
            background: white;
            padding: 25px;
            border-radius: 10px;
            text-align: center;
        }

        .error {
            color: #b40000;
        }

        footer {
            margin-top: 50px;
            background: #a90000;
            color: white;
            text-align: center;
            padding: 25px 15px;
        }

        @media (max-width: 600px) {
            header h1 {
                font-size: 23px;
            }

            nav a {
                padding: 10px 11px;
                font-size: 14px;
            }
        }
    </style>
</head>

<body>

<header>
    <div class="header-inner">
        <h1>Koperasi Desa Merah Putih Unjur</h1>
        <p>Informasi dan berita terbaru koperasi</p>
    </div>
</header>

<nav>
    <div class="nav-inner">
        <a href="index.html">Beranda</a>
        <a href="profil.html">Profil</a>
        <a href="unit-usaha.html">Unit Usaha</a>
        <a href="produk.html">Produk</a>
        <a href="anggota.html">Anggota</a>
        <a href="berita.html">Berita</a>
        <a href="galeri.html">Galeri</a>
        <a href="kontak.html">Kontak</a>
    </div>
</nav>

<main>

    <div class="judul-halaman">
        <h2>Berita Koperasi</h2>
        <p>Informasi terbaru Koperasi Desa Merah Putih Unjur</p>
    </div>

    <div id="beritaList" class="berita-list">
        <div class="kosong">
            Memuat berita...
        </div>
    </div>

</main>

<footer>
    <div>Koperasi Desa Merah Putih Unjur</div>
    <div>Desa Unjur, Kabupaten Samosir</div>
</footer>

<script>
    const API = "http://localhost:3000/api";

    function formatTanggal(tanggal) {
        if (!tanggal) return "";

        return new Date(tanggal).toLocaleDateString("id-ID", {
            day: "2-digit",
            month: "long",
            year: "numeric"
        });
    }

    function escapeHTML(text) {
        if (!text) return "";

        return String(text)
            .replace(/&/g, "&amp;")
            .replace(/</g, "&lt;")
            .replace(/>/g, "&gt;")
            .replace(/"/g, "&quot;")
            .replace(/'/g, "&#039;");
    }

    async function loadBerita() {
        const container = document.getElementById("beritaList");

        try {
            const response = await fetch(API + "/berita");

            if (!response.ok) {
                throw new Error("Gagal mengambil berita");
            }

            const berita = await response.json();

            if (!berita || berita.length === 0) {
                container.innerHTML = `
                    <div class="kosong">
                        Belum ada berita.
                    </div>
                `;
                return;
            }

            berita.sort((a, b) => {
                return new Date(b.tanggal) - new Date(a.tanggal);
            });

            container.innerHTML = berita.map(item => {

                let gambar = "";

                if (item.gambar) {
                    gambar = `
                        <img
                            class="berita-gambar"
                            src="${escapeHTML(item.gambar)}"
                            alt="${escapeHTML(item.judul)}"
                            onerror="this.style.display='none'"
                        >
                    `;
                } else {
                    gambar = `
                        <div class="berita-tanpa-gambar"></div>
                    `;
                }

                return `
                    <article class="berita-card">

                        ${gambar}

                        <div class="berita-content">

                            <h3>
                                ${escapeHTML(item.judul)}
                            </h3>

                            <div class="tanggal">
                                ${formatTanggal(item.tanggal)}
                            </div>

                            <div class="isi">
                                ${escapeHTML(item.isi)}
                            </div>

                        </div>

                    </article>
                `;

            }).join("");

        } catch (error) {

            console.error(error);

            container.innerHTML = `
                <div class="error">
                    Tidak dapat terhubung ke server berita.
                    <br><br>
                    Pastikan backend KDMP Unjur sedang berjalan.
                </div>
            `;
        }
    }

    loadBerita();
</script>

</body>
</html>
